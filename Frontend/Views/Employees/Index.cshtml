@model EmployeeListViewModel
@{
    ViewData["Title"] = "Employee Directory";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/employees.css" />
</head>
<body>

    <div id="app"
         data-api-url="/api/employees"
         data-delete-url-base="/api/employees"
         data-initial-page="@Model.CurrentPage"
         data-initial-page-size="@Model.PageSize"
         data-initial-search-term="@Model.SearchTerm"
         data-initial-total-records="@Model.TotalRecords">

        <!-- ============ HEADER ============ -->
        <header class="topbar">
            <div class="topbar__inner">
                <div class="brand-block">
                    <span class="eyebrow">Workforce</span>
                    <h1 class="page-title">Employee <em>Directory</em></h1>
                    <p class="record-count" id="recordSummary">
                        <strong>@Model.TotalRecords</strong> employee@(Model.TotalRecords == 1 ? "" : "s") on record
                    </p>
                </div>

                <div class="search-field" id="searchField">
                    <svg class="search-field__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="m20 20-3.5-3.5" />
                    </svg>
                    <input
                        id="searchInput"
                        type="search"
                        autocomplete="off"
                        placeholder="Search by name…"
                        value="@Model.SearchTerm"
                        aria-label="Search employees by name" />
                    <span class="search-field__kbd">/</span>
                    <button id="clearSearchBtn" type="button" class="search-field__clear" aria-label="Clear search">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18" />
                        </svg>
                    </button>
                </div>
            </div>
        </header>

        <!-- ============ MAIN ============ -->
        <main class="shell">

            <div class="table-panel">
                <div class="table-scroll" id="tableWrapper">
                    <table class="roster">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Job title</th>
                                <th>Email</th>
                                <th>Hired</th>
                                <th class="num">Salary</th>
                                <th class="row-actions"><span style="clip:rect(0,0,0,0);position:absolute;">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody id="employeeTableBody">
                            @foreach (var emp in Model.Employees)
                            {
                                <tr data-id="@emp.Id">
                                    <td>
                                        <div class="person">
                                            <div class="avatar" data-name="@emp.FirstName @emp.LastName">@($"{emp.FirstName[0]}{emp.LastName[0]}".ToUpper())</div>
                                            <span class="person__name">@emp.FirstName @emp.LastName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="dept">
                                            <span class="dept__dot" data-dept="@emp.Department"></span>
                                            @emp.Department
                                        </span>
                                    </td>
                                    <td class="cell-muted">@emp.JobTitle</td>
                                    <td class="cell-email">@emp.Email</td>
                                    <td class="num">@emp.HireDate.ToString("MMM d, yyyy")</td>
                                    <td class="num">@emp.Salary.ToString("C0")</td>
                                    <td class="row-actions">
                                        <button type="button" class="icon-btn delete-btn"
                                                data-id="@emp.Id" data-name="@emp.FirstName @emp.LastName"
                                                aria-label="Delete @emp.FirstName @emp.LastName">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2m2 0-1 13a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 7h14Z" />
                                            </svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="empty-state" id="emptyState">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="10" cy="10" r="6.5" /><path stroke-linecap="round" d="m19.5 19.5-4.8-4.8" />
                        <path stroke-linecap="round" d="M7.5 10h5" />
                    </svg>
                    <p class="empty-state__title">No employees found</p>
                    <p class="empty-state__hint" id="emptyStateHint">Try a different search term.</p>
                </div>
            </div>

            <div class="pager" id="paginationBar">
                <p class="pager__summary" id="pageInfo"></p>
                <div class="pager__controls">
                    <button id="prevPageBtn" type="button" class="pager__btn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" /></svg>
                        Previous
                    </button>
                    <span class="pager__indicator" id="pageIndicator"></span>
                    <button id="nextPageBtn" type="button" class="pager__btn">
                        Next
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" /></svg>
                    </button>
                </div>
            </div>
        </main>

        <!-- ============ DELETE CONFIRMATION ============ -->
        <div class="modal-veil" id="confirmModal" role="dialog" aria-modal="true" aria-labelledby="confirmModalTitle">
            <div class="modal-card">
                <h2 class="modal-card__title" id="confirmModalTitle">Remove this record?</h2>
                <p class="modal-card__body">
                    <strong id="confirmModalName"></strong> will be removed from the directory. This can't be undone.
                </p>
                <div class="modal-card__actions">
                    <button id="cancelDeleteBtn" type="button" class="btn btn--ghost">Cancel</button>
                    <button id="confirmDeleteBtn" type="button" class="btn btn--danger">
                        <span id="confirmDeleteSpinner" class="spinner" style="display:none;"></span>
                        <span id="confirmDeleteLabel">Delete</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- ============ TOASTS ============ -->
        <div class="toast-stack" id="toastContainer"></div>
    </div>

    <script src="~/js/employees.js"></script>
</body>
</html>
